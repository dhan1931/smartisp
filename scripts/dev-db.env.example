# Copie este archivo como scripts\dev-db.env (está ignorado por git) y complete los datos.
# Nunca versione credenciales reales.

# Host remoto de MySQL que muestra hPanel > Bases de datos > MySQL remoto (no "localhost").
MYSQL_HOST=<host-remoto-de-hostinger>
MYSQL_PORT=3306
MYSQL_DATABASE=<nombre-de-la-base>
# Recomendado: un usuario con permisos SOLO de lectura (SELECT).
MYSQL_USER=<usuario>
MYSQL_PASSWORD=<contraseña>
