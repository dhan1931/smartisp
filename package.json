{
  "name": "smartisp",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda SmartISP: páginas estáticas con Vite y API PHP/MariaDB para Hostinger",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-php.ps1",
    "build": "vite build",
    "lint": "node scripts/lint-source.mjs",
    "test": "npm run build && node scripts/check-build.mjs",
    "test:db": "php tests/bootstrap-mariadb.php && php scripts/migrate.php && php tests/assert-migrations.php && php scripts/migrate.php",
    "devflow": "bash scripts/devflow.sh",
    "devflow:login": "node scripts/devflow-login.cjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test:smoke": "node tests/smoke.integration.mjs",
    "test:e2e": "node tests/e2e/panel.e2e.mjs"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "esbuild": "^0.28.2",
    "lucide": "1.55.0",
    "mysql2": "^3.12.0",
    "playwright": "1.48.0",
    "sharp": "^0.35.4",
    "vite": "^6.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
