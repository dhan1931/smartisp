{
  "name": "smartisp",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda SmartISP con frontend Vite y API PHP/MySQL para Hostinger",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "vite build",
    "lint": "node scripts/lint-source.mjs",
    "test": "npm run build && node scripts/check-build.mjs",
    "test:db": "php tests/bootstrap-mariadb.php && php scripts/migrate.php && php tests/assert-migrations.php && php scripts/migrate.php",
    "import:intcomex": "node scripts/import-intcomex-products.js",
    "devflow": "bash scripts/devflow.sh",
    "devflow:login": "node scripts/devflow-login.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^7.0.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "vite": "^6.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "nodemailer": "^10.0.13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
