# ===================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO - SMARTISP
# ===================================================================

# Correo del administrador o empresa donde llegarán las alertas de compras con el celular del cliente
ADMIN_EMAIL=tu_correo_admin@gmail.com

# -------------------------------------------------------------------
# OPCIÓN A: USAR GMAIL (Recomendado y gratuito)
# -------------------------------------------------------------------
# 1. Ve a tu cuenta de Google: https://myaccount.google.com/security
# 2. Activa la "Verificación en dos pasos" si no la tienes activa.
# 3. Entra en "Contraseñas de aplicaciones" (https://myaccount.google.com/apppasswords).
# 4. Genera una contraseña para "SmartISP" (te dará un código de 16 letras).
# 5. Coloca tus datos aquí abajo:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="SmartISP Ventas <tu_correo@gmail.com>"

# -------------------------------------------------------------------
# OPCIÓN B: USAR RESEND (Para producción / Vercel)
# -------------------------------------------------------------------
# Si prefieres usar el servicio Resend (https://resend.com):
# RESEND_API_KEY=re_123456789...
# EMAIL_FROM="SmartISP <onboarding@resend.dev>"

