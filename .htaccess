DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proteger archivos sensibles
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^api/config\.php$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^\.git(/.*)?$ - [F,L]

    # Rutas amigables SEO para productos individuales y sitemaps
    RewriteRule ^sitemap-products\.xml$ sitemap-products.php [QSA,L]
    RewriteRule ^productos/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^producto/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^productos/?$ tienda.html [QSA,L]
    RewriteRule ^producto/?$ tienda.html [QSA,L]

    # Si el archivo o directorio solicitado existe físicamente en el servidor, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Enrutamiento universal de API hacia router.php
    RewriteRule ^api/auth/(.*)$ api/router.php?action=$1 [QSA,L]
    RewriteRule ^api/(.*)$ api/router.php?action=$1 [QSA,L]
</IfModule>
