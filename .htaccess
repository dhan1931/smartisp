DirectoryIndex index.html index.htm index.php

# Desactivar listado de directorios para evitar exploración de carpetas
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquear acceso a archivos sensibles, configuraciones, paquetes y repositorios
    RewriteRule ^\.env - [F,L]
    RewriteRule ^api/config\.php$ - [F,L]
    RewriteRule ^(package\.json|package-lock\.json|vite\.config\.js|tsconfig.*|\.git.*)$ - [F,L]
    RewriteRule \.(sql|bak|config|log|md)$ - [F,L]

    # Rutas amigables SEO para productos individuales y sitemaps
    RewriteRule ^sitemap-products\.xml$ sitemap-products.php [QSA,L]
    RewriteRule ^productos/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^producto/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^productos/?$ tienda.html [QSA,L]
    RewriteRule ^producto/?$ tienda.html [QSA,L]

    # Enrutamiento universal de API hacia router.php
    RewriteRule ^api/auth/(.*)$ api/router.php?action=$1 [QSA,L]
    RewriteRule ^api/(.*)$ api/router.php?action=$1 [QSA,L]
</IfModule>

<FilesMatch "^(\.env|config\.php|package\.json|package-lock\.json|vite\.config\.js|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Prevenir que navegadores guarden en caché páginas HTML desactualizadas
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Cabeceras de seguridad compatibles con HTTP/2 y Hostinger CDN
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
