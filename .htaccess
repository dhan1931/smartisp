DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proteger archivos sensibles
    RewriteRule ^\.env - [F,L]

    # Redireccionar /api/test-products al endpoint de diagnostico PHP si no hay reverse proxy a Node
    RewriteRule ^api/test-products/?$ api/test-products/index.php [QSA,L]
</IfModule>

