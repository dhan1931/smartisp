DirectoryIndex tienda.html index.html index.htm index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proteger archivos sensibles
    RewriteRule ^\.env - [F,L]
    RewriteRule ^api/config\.php - [F,L]
    RewriteRule ^api/(?!router\.php$).+\.php$ - [F,L]
    RewriteRule ^(?:package\.json|server\.js|vite\.config\.js|README\.md|CHANGELOG\.md|.*\.sql(?:\.gz)?)$ - [F,L,NC]

    # La raiz publica es la tienda; la presentacion queda archivada como index-presentacion.html.
    RewriteRule ^index\.html$ / [R=301,L]

    # Rutas amigables SEO para productos individuales y sitemaps
    RewriteRule ^sitemap-products\.xml$ sitemap-products.php [QSA,L]
    RewriteRule ^sitemap-categories\.xml$ sitemap-categories.php [QSA,L]
    RewriteRule ^productos-destacados/?$ productos-destacados.php [QSA,L]
    RewriteRule ^categorias-destacadas/?$ categorias-destacadas.php [QSA,L]
    RewriteRule ^servicios/?$ servicios.html [QSA,L]
    RewriteRule ^nosotros/?$ nosotros.html [QSA,L]
    RewriteRule ^categoria/([^/]+)/?$ categoria.php?slug=$1 [QSA,L]
    RewriteRule ^productos/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^producto/([^/]+)/?$ producto.php?slug=$1 [QSA,L]
    RewriteRule ^productos/?$ tienda.html [QSA,L]
    RewriteRule ^producto/?$ tienda.html [QSA,L]

    # Enrutamiento universal de API hacia router.php (evita bucle interno)
    RewriteCond %{REQUEST_URI} !/api/router\.php
    RewriteRule ^api/auth/(.*)$ api/router.php?action=$1 [QSA,L]

    RewriteCond %{REQUEST_URI} !/api/router\.php
    RewriteRule ^api/(.*)$ api/router.php?action=$1 [QSA,L]
</IfModule>
