DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proteger archivos sensibles y configuraciones
    RewriteRule ^\.env - [F,L]
    RewriteRule ^api/config\.php$ - [F,L]

    # Enrutamiento de diagnósticos
    RewriteRule ^api/test-products/?$ api/router.php?action=test-products [QSA,L]
    RewriteRule ^api/test-db/?$ api/router.php?action=test-db [QSA,L]

    # Enrutamiento universal de API hacia router.php
    RewriteRule ^api/auth/(.*)$ api/router.php?action=$1 [QSA,L]
    RewriteRule ^api/(.*)$ api/router.php?action=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Prevenir que navegadores móviles (iOS / Android) guarden en caché páginas HTML desactualizadas
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

